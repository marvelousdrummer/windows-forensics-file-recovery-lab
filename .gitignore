# Large forensic media and virtual disks
*.vdi
*.vmdk
*.vhd
*.vhdx
*.iso
*.img
*.raw
*.dd
*.E01
*.e01

# Real or unreviewed evidence files
/evidence/
/testdata/
/originals/
/recovered/

# Secrets / local environment
.env
.env.*
*.key
*.pem
.venv/
venv/
__pycache__/
*.py[cod]

# Avoid accidental uploads of institutional assignment files
*Course_Materials*/
*Assignment_Submission*/
